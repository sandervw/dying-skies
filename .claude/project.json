{
  "reviews": {
    "codeSuffixes": [
      ".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs",
      ".sql", ".sh", ".tf"
    ],
    "securityPaths": [
      ".github/",
      ".claude/hooks/",
      ".claude/settings.json",
      ".claude/project.json",
      ".mcp.json",
      "backend/app/",
      "backend/requirements.txt",
      "backend/Dockerfile",
      "backend/docker-compose.yml",
      "infra/",
      "frontend/src/services/authService.ts",
      "frontend/src/services/starApiService.ts",
      "frontend/vite.config.ts",
      "frontend/wrangler.jsonc",
      "analytics/dbt/profiles.yml",
      "analytics/observable/db.js",
      "analytics/observable/wrangler.jsonc",
      "analytics/orchestration/alert.py"
    ]
  },
  "blackbox": {
    "readablePaths": [".docs/use-cases", "tests/e2e"],
    "specFolder": "tests/e2e",
    "testCommands": [
      ["npx", "playwright", "test"],
      ["npm", "run", "test:e2e"]
    ],
    "startCommands": [["npm", "run", "dev"]],
    "safeFlags": ["--project=[\\w.-]+", "--grep=.+", "--headed", "--reporter=[A-Za-z-]+"],
    "allowedTools": [
      "SubagentHandback",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_verify_element_visible",
      "mcp__playwright__browser_verify_list_visible",
      "mcp__playwright__browser_verify_text_visible",
      "mcp__playwright__browser_verify_value",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_close"
    ],
    "navigateTools": ["mcp__playwright__browser_navigate"],
    "allowedHosts": ["localhost", "127.0.0.1"],
    "allowedHostSuffixes": []
  }
}
