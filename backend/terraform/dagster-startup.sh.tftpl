#!/usr/bin/env bash
set -euo pipefail

APP_DIR=/opt/dying-skies
ANALYTICS_DIR=$APP_DIR/analytics
ENV_DIR=/etc/dying-skies
DAGSTER_HOME=/var/lib/dagster
CONNECTION_NAME="${connection_name}"

# System packages.
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y git curl ca-certificates python3

# Node for the Observable site build and deploy.
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs
npm install -g wrangler

# uv, installed system-wide.
export UV_INSTALL_DIR=/usr/local/bin
curl -LsSf https://astral.sh/uv/install.sh | sh

# Cloud SQL Auth Proxy.
curl -o /usr/local/bin/cloud-sql-proxy \
  https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.14.1/cloud-sql-proxy.linux.amd64
chmod +x /usr/local/bin/cloud-sql-proxy

# Service user and directories.
id dagster >/dev/null 2>&1 || useradd --system --create-home --home-dir $APP_DIR --shell /usr/sbin/nologin dagster
mkdir -p $ENV_DIR $DAGSTER_HOME
chown -R dagster:dagster $APP_DIR $DAGSTER_HOME

# Read secrets via the VM metadata access token.
metadata_token() {
  curl -s -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | python3 -c "import sys,json;print(json.load(sys.stdin)['access_token'])"
}
read_secret() {
  curl -s -H "Authorization: Bearer $(metadata_token)" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$1/versions/latest:access" \
    | python3 -c "import sys,json,base64;print(base64.b64decode(json.load(sys.stdin)['payload']['data']).decode())"
}

ANALYTICS_DB_PASSWORD="$(read_secret ${analytics_reader_secret})"
CLOUDFLARE_API_TOKEN="$(read_secret ${cloudflare_token_secret})"

# Runtime env for dbt, the site deploy, and alerts.
cat > $ENV_DIR/dagster.env <<EOF
DAGSTER_HOME=$DAGSTER_HOME
PYTHONPATH=$ANALYTICS_DIR
ANALYTICS_DB_HOST=127.0.0.1
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=dying_skies
ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=$ANALYTICS_DB_PASSWORD
ANALYTICS_DB_SCHEMA=analytics
CLOUDFLARE_ACCOUNT_ID=${cloudflare_account_id}
CLOUDFLARE_API_TOKEN=$CLOUDFLARE_API_TOKEN
ALERT_FROM=${alert_from}
ALERT_TO=${alert_to}
EOF
chmod 600 $ENV_DIR/dagster.env
chown dagster:dagster $ENV_DIR/dagster.env

# App code cloned via a temp dir; home already exists.
if [ ! -d "$ANALYTICS_DIR" ]; then
  CLONE_TMP="$(mktemp -d)"
  if git clone --depth 1 "${repo_url}" "$CLONE_TMP"; then
    cp -a "$CLONE_TMP/." "$APP_DIR/"
  else
    echo "clone failed; deploy code to $APP_DIR manually"
  fi
  rm -rf "$CLONE_TMP"
fi
if [ -d "$ANALYTICS_DIR" ]; then
  chown -R dagster:dagster "$APP_DIR"
  # Sync deps, then build the dbt manifest the code location needs.
  su dagster -s /bin/bash -c "cd $ANALYTICS_DIR && /usr/local/bin/uv sync && set -a && . $ENV_DIR/dagster.env && set +a && /usr/local/bin/uv run dbt parse --project-dir dbt --profiles-dir dbt" || true
fi

cat > /etc/systemd/system/cloud-sql-proxy.service <<EOF
[Unit]
Description=Cloud SQL Auth Proxy
After=network-online.target
Wants=network-online.target

[Service]
User=dagster
ExecStart=/usr/local/bin/cloud-sql-proxy --port 5432 $CONNECTION_NAME
Restart=always

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/dagster-daemon.service <<EOF
[Unit]
Description=Dagster daemon
Requires=cloud-sql-proxy.service
After=cloud-sql-proxy.service

[Service]
User=dagster
WorkingDirectory=$ANALYTICS_DIR
EnvironmentFile=$ENV_DIR/dagster.env
ExecStart=/usr/local/bin/uv run dagster-daemon run
Restart=always

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/dagster-webserver.service <<EOF
[Unit]
Description=Dagster webserver
Requires=cloud-sql-proxy.service
After=cloud-sql-proxy.service

[Service]
User=dagster
WorkingDirectory=$ANALYTICS_DIR
EnvironmentFile=$ENV_DIR/dagster.env
ExecStart=/usr/local/bin/uv run dagster-webserver -h 127.0.0.1 -p 3000
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl reset-failed cloud-sql-proxy.service dagster-daemon.service dagster-webserver.service 2>/dev/null || true
systemctl enable --now cloud-sql-proxy.service
systemctl enable --now dagster-daemon.service dagster-webserver.service
