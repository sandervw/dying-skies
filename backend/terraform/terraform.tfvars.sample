# Copy to terraform.tfvars and fill. The real file is gitignored.
project_id = "dying-skies"
image      = "us-central1-docker.pkg.dev/dying-skies/dying-skies/api:latest"

# Secrets: openssl rand -hex 24, seed uses -hex 32.
db_password               = ""
seed_hmac_secret          = ""
analytics_reader_password = ""

# Analytics Dagster VM.
cloudflare_account_id = ""
cloudflare_api_token  = ""

# Zero Trust tunnel connector token for the Dagster UI; empty skips it.
cloudflare_tunnel_token = ""
