# Backend. Copy to .env and fill values.
DATABASE_URL=
# SEED_HMAC_SECRET is hex-encoded bytes.
SEED_HMAC_SECRET=
FRONTEND_ORIGIN=
# Defaults to true; set false only for local http development.
COOKIE_SECURE=
# Set false to disable per-IP rate limiting (tests do this).
RATE_LIMIT_ENABLED=
# Proxy hops in front of the app; set to trust X-Forwarded-For (Cloudflare Tunnel).
TRUSTED_PROXY_HOPS=
# Set to provision the read-only analytics_reader role on startup.
ANALYTICS_READER_PASSWORD=
