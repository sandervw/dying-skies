{
  "name": "dying-skies-analytics-site",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rimraf src/.observablehq/cache dist",
    "dev": "observable preview",
    "build": "observable build",
    "deploy": "rimraf src/.observablehq/cache/data && observable build && node -e \"require('fs').copyFileSync('_headers', 'dist/_headers')\" && wrangler deploy",
    "observable": "observable"
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.4",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "wrangler": "^4.167.0"
  },
  "engines": {
    "node": ">=20"
  }
}
