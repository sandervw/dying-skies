{
  "name": "dying-skies-analytics",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/"
  },
  // More-specific route wins over the frontend's dyingskies.com/* custom domain.
  "routes": [
    { "pattern": "dyingskies.com/analytics/*", "zone_name": "dyingskies.com" }
  ]
}
